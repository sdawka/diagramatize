# Providers: openrouter | anthropic | gemini | openai | mock
# Leave unset to auto-pick the first provider with a key (falls back to mock).
LLM_PROVIDER=
IMAGE_PROVIDER=

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model overrides (OpenRouter slugs shown; direct providers use their own ids)
# General orchestration: follow-up questions, composition planning.
LLM_MODEL=openai/gpt-6-luna
# First-principles analysis, the concept/mechanism, and locating components in the picked image.
LLM_SYNTHESIS_MODEL=anthropic/claude-sonnet-5.5
# Per-task overrides: LLM_MODEL_CLARIFY, LLM_MODEL_CONCEPT, LLM_MODEL_COMPOSITION, LLM_MODEL_DECOMPOSE
DRAFT_IMAGE_MODEL=recraft/recraft-v4.1-flash
CANDIDATE_IMAGE_MODEL=openai/gpt-image-2
REGEN_IMAGE_MODEL=google/gemini-nano-banana-2.1
VECTOR_IMAGE_MODEL=recraft/recraft-v4.1-vector
LAYER_IMAGE_MODEL=inclusionai/ming-image-0.1-design-layer

